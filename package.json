{
	"name": "lafka-theme",
	"version": "7.4.0",
	"private": true,
	"description": "Lafka WordPress Theme",
	"scripts": {
		"lint:js": "eslint --max-warnings=0 --cache --cache-strategy content --cache-location .eslintcache .",
		"lint:js:fix": "eslint --cache --cache-strategy content --cache-location .eslintcache . --fix",
		"lint:css": "stylelint --max-warnings=0 --cache --cache-strategy content --cache-location .stylelintcache '**/*.css' && node scripts/check-tokens.mjs",
		"lint:css:fix": "stylelint --cache --cache-strategy content --cache-location .stylelintcache '**/*.css' --fix",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
		"build": "node scripts/build-assets.mjs && node scripts/build-theme-json.mjs",
		"build:theme-json": "node scripts/build-theme-json.mjs",
		"i18n:pot": "../local-env/lafka wp i18n make-pot wp-content/themes/lafka wp-content/themes/lafka/languages/lafka.pot --slug=lafka --domain=lafka --package-name=Lafka --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/setkernel/lafka-theme/issues\"}' --exclude=node_modules,vendor,scripts,docs,presets,assets",
		"sync:fonts": "node scripts/nx2-03-sync-fonts.mjs",
		"previews:presets": "node scripts/nx2-04-preset-previews.mjs",
		"sync-version": "node scripts/sync-version.mjs",
		"check-version": "node scripts/sync-version.mjs --check",
		"version": "node scripts/sync-version.mjs --stage",
		"check-theme-json": "node scripts/build-theme-json.mjs --check"
	},
	"versionSync": [
		{
			"file": "style.css",
			"pattern": "^\\s*Version:\\s*(\\d+\\.\\d+\\.\\d+[^\\s]*)",
			"flags": "m",
			"required": true
		},
		{
			"file": "readme.txt",
			"pattern": "^Version:\\s*(\\d+\\.\\d+\\.\\d+[^\\s]*)",
			"flags": "m",
			"required": true
		}
	],
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource/archivo": "^5.3.0",
		"@fontsource/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource/dm-serif-display": "^5.3.0",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/lora": "^5.3.0",
		"@fontsource/manrope": "^5.3.0",
		"@fontsource/rubik": "^5.3.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"@wordpress/stylelint-config": "^26.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"playwright": "^1.64.0",
		"stylelint": "^17.16.0"
	}
}
