{
	"name": "lafka/lafka-theme",
	"description": "Lafka WordPress Theme",
	"type": "wordpress-theme",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.13.6",
		"wp-coding-standards/wpcs": "^3.4.1",
		"phpcompatibility/phpcompatibility-wp": "^3.0.0-alpha2@alpha",
		"phpcompatibility/php-compatibility": "^10.0.0-alpha2@alpha",
		"phpcompatibility/phpcompatibility-paragonie": "^2.0.0-alpha2@alpha",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.3"
		}
	},
	"scripts": {
		"lint:php": "find . -name '*.php' -not -path './vendor/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 -P4 php -d display_errors=stderr -l > /dev/null",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf"
	}
}
