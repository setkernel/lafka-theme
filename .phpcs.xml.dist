<?xml version="1.0"?>
<ruleset name="Lafka Theme">
	<description>WordPress coding standards for Lafka Theme</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Show progress and sniff codes in all reports -->
	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- Speed: sniff files in parallel and skip unchanged files on re-runs
	     (.phpcs.cache is git-ignored; CI restores it with actions/cache). -->
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs.cache"/>

	<!-- Strip the filepaths down to the relevant bit -->
	<arg name="basepath" value="."/>

	<!-- Rules: the full WordPress-Extra standard, no exclusions, and warnings fail the run. -->
	<rule ref="WordPress-Extra"/>


	<!-- This is a theme: template-hierarchy file names such as
	     taxonomy-lafka_foodmenu_category.php follow WordPress's naming. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="true"/>
		</properties>
	</rule>

	<!-- Cross-version PHP compatibility against the 8.3 floor. PHPCompatibility
	     10 (alpha, same as lafka-plugin) is required: 9.3.5 has no PHP 8.x sniffs. -->
	<config name="testVersion" value="8.3-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- WordPress text domain -->
	<config name="text_domain" value="lafka"/>

	<!-- Minimum supported WordPress version (WP 7.0 floor) -->
	<config name="minimum_wp_version" value="7.0"/>

	<!-- Exclude third-party code only (dependencies, and the unmodified upstream TGM Plugin Activation library) -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/incl/tgm-plugin-activation/*</exclude-pattern>
</ruleset>
