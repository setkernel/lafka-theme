{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#B0271D"
				},
				{
					"slug": "accent-hover",
					"name": "Accent Hover",
					"color": "#962018"
				},
				{
					"slug": "on-accent",
					"name": "Text on Accent",
					"color": "#FFFFFF"
				},
				{
					"slug": "brand",
					"name": "Brand",
					"color": "#2E6A3B"
				},
				{
					"slug": "text-primary",
					"name": "Text",
					"color": "#1F1B18"
				},
				{
					"slug": "text-secondary",
					"name": "Text Secondary",
					"color": "#3F3832"
				},
				{
					"slug": "text-muted",
					"name": "Text Muted",
					"color": "#57504A"
				},
				{
					"slug": "background",
					"name": "Background",
					"color": "#FFFFFF"
				},
				{
					"slug": "background-subtle",
					"name": "Background Subtle",
					"color": "#F6F3EE"
				},
				{
					"slug": "background-input",
					"name": "Background Input",
					"color": "#F6F3EE"
				},
				{
					"slug": "border-light",
					"name": "Border Light",
					"color": "#E3DCD2"
				},
				{
					"slug": "border-default",
					"name": "Border Default",
					"color": "#D9D0C4"
				},
				{
					"slug": "border-medium",
					"name": "Border Medium",
					"color": "#D9D0C4"
				},
				{
					"slug": "border-dark",
					"name": "Border Dark",
					"color": "#8C8177"
				},
				{
					"slug": "status-error",
					"name": "Error",
					"color": "#9E231A"
				},
				{
					"slug": "status-warning",
					"name": "Warning",
					"color": "#b45309"
				},
				{
					"slug": "status-success",
					"name": "Success",
					"color": "#2E6A3B"
				},
				{
					"slug": "status-info",
					"name": "Info",
					"color": "#1d4ed8"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"dropCap": false,
			"fluid": true,
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.1875rem"
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "2.75rem"
				},
				{
					"slug": "xx-large",
					"name": "XX Large",
					"size": "clamp(2.1875rem, 1.6rem + 2.6vw, 3.875rem)"
				}
			],
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"Atkinson Hyperlegible Next\", verdana, sans-serif"
				},
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Bricolage Grotesque\", \"Trebuchet MS\", sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, sfmono-regular, \"SF Mono\", menlo, consolas, monospace"
				}
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{
					"slug": "xs",
					"name": "XS",
					"size": "4px"
				},
				{
					"slug": "sm",
					"name": "Small",
					"size": "8px"
				},
				{
					"slug": "md",
					"name": "Medium",
					"size": "12px"
				},
				{
					"slug": "lg",
					"name": "Large",
					"size": "16px"
				},
				{
					"slug": "xl",
					"name": "XL",
					"size": "20px"
				},
				{
					"slug": "2xl",
					"name": "2XL",
					"size": "24px"
				},
				{
					"slug": "3xl",
					"name": "3XL",
					"size": "32px"
				},
				{
					"slug": "4xl",
					"name": "4XL",
					"size": "40px"
				},
				{
					"slug": "5xl",
					"name": "5XL",
					"size": "48px"
				}
			]
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1400px"
		}
	},
	"styles": {
		"color": {
			"text": "var(--wp--preset--color--text-primary)",
			"background": "var(--wp--preset--color--background)"
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"h1": {
				"color": {
					"text": "var(--wp--preset--color--text-primary)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.2"
				}
			},
			"h2": {
				"color": {
					"text": "var(--wp--preset--color--text-primary)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.25"
				}
			},
			"h3": {
				"color": {
					"text": "var(--wp--preset--color--text-primary)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.3"
				}
			},
			"button": {
				"color": {
					"text": "var(--wp--preset--color--on-accent)",
					"background": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-hover)"
					}
				}
			}
		}
	}
}
