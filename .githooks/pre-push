#!/usr/bin/env bash
#
# Pre-push hook for lafka-theme.
#
# Runs the repository's quality gates — PHPCS, ESLint, Stylelint and the
# version-consistency check — in parallel, and prints the output of any gate
# that fails. Every gate always runs; nothing is skipped.
#
# Install (one-time per clone):
#     git config core.hooksPath .githooks
#     composer install && npm ci
#

set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

red()   { printf '\033[31m%s\033[0m\n' "$1"; }
green() { printf '\033[32m%s\033[0m\n' "$1"; }
blue()  { printf '\033[36m%s\033[0m\n' "$1"; }

if [ ! -d node_modules ]; then
	red "✖ pre-push: node_modules is missing, so ESLint, Stylelint and the version check cannot run."
	red "   Run 'npm ci' (and 'composer install' for PHPCS), then push again."
	exit 1
fi

if [ ! -x vendor/bin/phpcs ]; then
	red "✖ pre-push: vendor/bin/phpcs is missing, so PHPCS cannot run."
	red "   Run 'composer install', then push again."
	exit 1
fi

logs="$(mktemp -d)"
trap 'rm -rf "$logs"' EXIT

names=()
pids=()
run() {
	local name="$1"
	shift
	names+=( "$name" )
	"$@" >"$logs/$name.log" 2>&1 &
	pids+=( $! )
}

blue "▸ pre-push: PHPCS, ESLint, Stylelint and version check (in parallel)"
run PHPCS composer phpcs
run ESLint npm run lint:js --silent
run Stylelint npm run lint:css --silent
run Version npm run check-version --silent

failed=0
for i in "${!pids[@]}"; do
	if ! wait "${pids[$i]}"; then
		failed=1
		red "✖ pre-push: ${names[$i]} FAILED"
		tail -n 40 "$logs/${names[$i]}.log"
	fi
done

if [ "$failed" -ne 0 ]; then
	red "   fix the failures above, then push again."
	exit 1
fi

green "✓ pre-push: all gates passed"
