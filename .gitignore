# Commercial plugins (must be purchased separately)
plugins/*.zip

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Dependencies
node_modules/
vendor/

# Tool caches
.phpcs.cache
.eslintcache
.stylelintcache
.tmp-screenshots/

# Minified build artefacts (NX1-10b): generated by `npm run build`
# (scripts/build-assets.mjs) and regenerated in release.yml before packaging.
# Never committed — the runtime switch (incl/system/asset-min.php) serves them
# only when present on disk.
/styles/*.min.css
/js/*.min.js
# Exception: lafka-dialog.min.js is build output that lafka-plugin registers
# by path, so it stays committed (CI fails if it drifts from `npm run build`).
!/js/lafka-dialog.min.js

# Misc
*.log
*.bak
*.orig

# Local agent/brainstorming scratch
/.superpowers/
